{
  "name": "hybrid-pro-backend",
  "version": "0.0.1",
  "description": "Hybrid Pro NestJS backend — subscriptions and coach APIs",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (process.env.NODE_ENV === 'production' || process.env.CI === 'true' || process.env.HUSKY === '0' || !existsSync('.husky/install.mjs')) process.exit(0); await import('./.husky/install.mjs')\"",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/ test/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.3",
    "@nestjs/websockets": "^12.0.3",
    "@supabase/supabase-js": "^2.116.0",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "^14.4.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2"
  }
}
